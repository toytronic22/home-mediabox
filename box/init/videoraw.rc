on property:sys.boot_completed=1
    start videoraw

# Держит обработку картинки выключенной: видео идёт на телевизор без
# «улучшений» приставки. Нужен root — узлы в /sys/class/video принадлежат root.
service videoraw /system/bin/sh /data/local/tmp/aria2/videoraw.sh
    class late_start
    user root
    group root
    seclabel u:r:su:s0
    disabled
